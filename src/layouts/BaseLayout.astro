---
import "../styles/global.css";
import HoverLabel from "../components/HoverLabel.astro";
import ContactPod from "../components/ContactPod.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portfolio of Rudaina Suwaiba." } = Astro.props;

/* Absolute URLs, built from `site` in astro.config.mjs. Social platforms
   silently ignore a relative og:image, so these cannot be plain paths. */
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Link previews. Every page carries its own title and description, so a
        shared /play link reads as Play rather than as the site's front door.

        The image is the same one everywhere: it is the wordmark, which is the
        thing worth recognising in a feed, and one image means one file for the
        platforms to cache. Dimensions are declared because several platforms
        reserve the space before the image arrives — without them the card can
        reflow, or fall back to a small thumbnail on a slow connection. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rudaina Suwaiba" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Rudaina Suwaiba, drawn as bubble lettering" />

    {/* `summary_large_image` is what makes the card full-width rather than a
        thumbnail beside the text. The rest is read from the og tags above. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Satoshi is self-hosted — the @font-face rules are in styles/global.css.

        Only the bold is preloaded. It is the weight every page uses first (nav,
        buttons, labels), and preloading it starts the download alongside the
        stylesheet instead of after it. The other two are wanted later or not at
        all, so preloading them would compete for the same bandwidth.

        `crossorigin` is required even though this is same-origin: fonts are
        fetched in CORS mode, and without it the browser treats the preload as a
        different request and downloads the file twice. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Satoshi-Bold.woff2"
      crossorigin
    />

    {/* Blocking and inline on purpose: it must run before first paint so the
        pre-hide rule in global.css applies without a flash.

        The failsafe matters. `js-motion` hides the hero's contents until GSAP
        reveals them, so if that module never loads — network blip, JS error,
        blocked bundle — the page would sit blank forever. Dropping the class
        after 3s guarantees content appears regardless. It cannot interrupt a
        normal entrance: GSAP writes inline `visibility`, which outranks the
        class rule, so removing the class is a no-op once motion is running. */}
    <script is:inline>
      document.documentElement.classList.add("js-motion");
      setTimeout(function () {
        document.documentElement.classList.remove("js-motion");
      }, 3000);
    </script>
  </head>
  <body>
    <slot />

    {/* Body level, never inside Stage — see HoverLabel.astro. */}
    <HoverLabel />

    {/* Also body level, and for the same reason plus one more: the pod is
        `position: fixed`, and a Stage's container query would become its
        containing block. See ContactPod.astro. */}
    <ContactPod />

    <script>
      // Site-wide. Binding is delegated from the document, so elements only
      // need `data-sfx-hover` / `data-sfx-click` to opt in.
      import { initSfx } from "../scripts/audio/sfx";
      import { initShine } from "../scripts/motion/shine";
      import { initHoverLabel } from "../scripts/motion/hover-label";
      import { initContactPod } from "../scripts/motion/contact-pod";
      initSfx();
      // All no-op on pages that render no matching elements.
      initShine();
      initHoverLabel();
      // Reachable from the nav on every page, so it is bound here.
      initContactPod();
    </script>
  </body>
</html>
