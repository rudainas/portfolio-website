---
/**
 * Streak layer for the page transition.
 *
 * Renders only an empty container — the streaks themselves are created by
 * scripts/motion/page-transition.ts, because one is needed per confetti shape
 * at whatever position that shape happens to occupy.
 *
 * Figma: Rectangle 4 (1534:4381), Rectangle 10 (1534:4382), Rectangle 6
 * (1534:4383), Rectangle 7 (1534:4384), Rectangle 8 (1534:4385).
 * Each is 25 x 717 with a 92px radius — well past half the width, so they
 * render as stadiums.
 *
 * Two notes on fidelity:
 *  - 1534:4382 and 1534:4384 are byte-identical pink gradients, and 1534:4381
 *    (an image fill) matches 1534:4385's blue. Five nodes, three looks. All
 *    five class names are kept so the mapping back to Figma is traceable.
 *  - 4381 ships as a PNG in Figma; it is reproduced here as the same CSS
 *    gradient as 4385 rather than downloading a bitmap for a flat ramp.
 */
---

<div class="streaks" data-streaks aria-hidden="true"></div>

<style>
  .streaks {
    position: absolute;
    inset: 0;
    z-index: var(--layer-streaks);
    pointer-events: none;
    overflow: hidden;
  }

  /* Created in JS, so these are :global — Astro's scoping only rewrites
     selectors it can see in this file's markup. */
  .streaks :global(.streak) {
    position: absolute;
    /* 25 / 1728 and 717 / 1728 of the design canvas. */
    width: max(8px, 1.4468cqw);
    height: max(160px, 41.4931cqw);
    /* Positioned by its BOTTOM edge (the script sets `bottom`), so the streak
       grows upward out of the shape it replaces. Anchoring by `top` would need
       a -100% vertical offset, and negative offsets cannot be clamped with
       max() — max(-4px, -9px) is -4px, which silently drops the offset. */
    transform-origin: 50% 100%;
    margin-left: calc(max(8px, 1.4468cqw) / -2);
    border-radius: 999px;
    will-change: transform, opacity;
  }

  /* Figma 1534:4381 — image fill, matched to the 4385 ramp. */
  .streaks :global(.streak--rect-4),
  /* Figma 1534:4385 */
  .streaks :global(.streak--rect-8) {
    background: linear-gradient(to top, #def6ff, var(--color-sky));
  }

  /* Figma 1534:4382 */
  .streaks :global(.streak--rect-10),
  /* Figma 1534:4384 — identical to 4382 */
  .streaks :global(.streak--rect-7) {
    background: linear-gradient(to top, rgb(255 233 243 / 0.75), var(--color-pink));
  }

  /* Figma 1534:4383 */
  .streaks :global(.streak--rect-6) {
    background: linear-gradient(to top, rgb(255 252 227 / 0.75), var(--color-yellow));
  }
</style>
