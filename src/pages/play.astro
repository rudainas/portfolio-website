---
import BaseLayout from "../layouts/BaseLayout.astro";
import Stage from "../components/Stage.astro";
import PlayField from "../components/PlayField.astro";
import DrawWidget from "../components/DrawWidget.astro";
---

<BaseLayout
  title="Play — Rudaina Suwaiba"
  description="An endless field of posters, logos and experiments by Rudaina Suwaiba."
>
  {/* `fit`: the field is endless and claims the wheel for its own panning, so
      there is no page scroll to recover anything the design's aspect ratio
      would push below the fold on a wide screen. */}
  <Stage active="play" fit>
    <div class="play" data-page-content>
      <PlayField />

      {/* Marks land BEHIND the work, above the grid and confetti. The canvas
          never takes the pointer itself — it cannot, sitting under the pieces —
          so a separate transparent sheet above them does the catching while an
          ink is armed. See scripts/motion/draw.ts. */}
      <canvas class="play__canvas" data-draw-canvas aria-hidden="true"></canvas>
      <div class="play__capture" data-draw-capture aria-hidden="true"></div>

      <DrawWidget />
    </div>
  </Stage>

  <script>
    import { initPlayField } from "../scripts/motion/play-field";
    import { initDraw } from "../scripts/motion/draw";
    import { initPrinter } from "../scripts/motion/printer";
    initPlayField();
    initDraw();
    initPrinter();
  </script>
</BaseLayout>

<style>
  .play {
    position: absolute;
    inset: 0;
  }

  /* Above the grid and the confetti, below the work. Equal z-index to the
     confetti but later in the document, so it paints over it. */
  .play__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: var(--layer-confetti);
    /* Never interactive: it is underneath the pieces, so it could not be hit
       reliably anyway. The capture sheet below does that job. */
    pointer-events: none;
  }

  /* The sheet that catches strokes. Sits above the work so a mark can be drawn
     across a piece, and below the printer so the ink can still be switched off.
     Inert until draw.ts arms it. */
  .play__capture {
    position: absolute;
    inset: 0;
    z-index: var(--layer-wordmark);
    pointer-events: none;
    touch-action: none;
  }

  :global(html[data-drawing]) .play__capture {
    pointer-events: auto;
  }

  /* While the pen is armed the whole page takes the drawing cursor, so it is
     obvious the click will make a mark rather than move the field. */
  :global(html[data-drawing]) .play,
  :global(html[data-drawing]) .play__capture {
    cursor: var(--cursor-grab);
    cursor: var(--cursor-grab-hidpi);
  }
</style>
